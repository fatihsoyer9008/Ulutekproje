# Copy this file to .env for local development.
APP_NAME=Receipt Parser API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://receipt_app:local-postgres-password@127.0.0.1:5432/receipt_app
# Host port overrides for Docker Compose when 5432/6379 are already in use.
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://:local-redis-password@127.0.0.1:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=ulutekproje-api
JWT_AUDIENCE=ulutekproje-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SECURITY_HMAC_SECRET=replace-with-an-independent-random-secret
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
EMAIL_DELIVERY_MODE=smtp
# Gmail: smtp.gmail.com:587, SMTP_USER=adresiniz, SMTP_PASSWORD=uygulama şifresi
# SendGrid: smtp.sendgrid.net:587, SMTP_USER=apikey, SMTP_PASSWORD=API anahtarı
EMAIL_FROM=your-verified-sender@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=15
APP_DEEP_LINK_BASE_URL=fiskon://auth
# Must include the Web OAuth client ID used as Flutter GOOGLE_SERVER_CLIENT_ID.
# Multiple accepted web client IDs may be comma-separated.
GOOGLE_OAUTH_CLIENT_IDS=web-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=com.example.fiskon
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# Preserve PEM newlines with \n when your secret manager requires one line.
APPLE_PRIVATE_KEY=
# URL-safe base64 Fernet key; generate independently from JWT/HMAC secrets.
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
APPLE_REVOKE_URL=https://appleid.apple.com/auth/revoke
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
USE_DUMMY_PARSER=true
