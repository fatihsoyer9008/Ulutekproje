# Copy this file to .env for local development.
APP_NAME=Receipt Parser API
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://receipt_app:local-postgres-password@127.0.0.1:5432/receipt_app
# Host port overrides for Docker Compose when 5432/6379 are already in use.
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_URL=redis://:local-redis-password@127.0.0.1:6379/0
# Grup borc ozeti Redis cache suresi (5 dakika).
DEBT_SUMMARY_CACHE_TTL_SECONDS=300
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ISSUER=ulutekproje-api
JWT_AUDIENCE=ulutekproje-mobile
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
SECURITY_HMAC_SECRET=replace-with-an-independent-random-secret
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
TRUSTED_CLIENT_IP_HEADER=
TRUSTED_PROXY_CIDRS=
# Gerçek Gemini anahtarı hazır olana kadar production'da false bırak.
RECEIPT_IMAGE_UPLOAD_ENABLED=false
# Multipart fiş fotoğrafının bayt cinsinden üst sınırı: 10 MiB.
RECEIPT_IMAGE_MAX_BYTES=10485760
# Decode edilen görüntünün maksimum piksel sayısı: 25 megapiksel.
RECEIPT_IMAGE_MAX_PIXELS=25000000
# Aynı process içinde eşzamanlı Pillow işleme sayısı.
RECEIPT_IMAGE_PROCESSING_CONCURRENCY=2
# Receipt Gemini maliyet koruması için sabit pencere limitleri.
RECEIPT_IP_BURST_LIMIT=10
RECEIPT_IP_DAILY_LIMIT=50
RECEIPT_INSTALLATION_BURST_LIMIT=5
RECEIPT_INSTALLATION_DAILY_LIMIT=25
EMAIL_DELIVERY_MODE=smtp
# Gmail için SMTP kullanıcı adı e-posta adresidir; parola uygulama şifresidir.
# SendGrid için SMTP kullanıcı adı "apikey", parola ise API anahtarıdır.
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# Set only in backend/.env or the deployment platform's encrypted secrets.
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=15
# Public HTTPS backend address. Cloudflare quick-tunnel addresses change on restart.
EMAIL_ACTION_BASE_URL=https://your-api.example.com/api/v1/auth
APP_DEEP_LINK_BASE_URL=fiskon://auth
# Must include the Web OAuth client ID used as Flutter GOOGLE_SERVER_CLIENT_ID.
# Multiple accepted web client IDs may be comma-separated. OAuth client IDs
# are public identifiers; never place the client secret in this file.
GOOGLE_OAUTH_CLIENT_IDS=356175797700-cvih7hepb72j56deugtirr38sqf3h1sd.apps.googleusercontent.com
APPLE_CLIENT_ID=com.example.fiskon
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
# Preserve PEM newlines with \n when your secret manager requires one line.
APPLE_PRIVATE_KEY=
# URL-safe base64 Fernet key; generate independently from JWT/HMAC secrets.
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_ISSUER=https://appleid.apple.com
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_TOKEN_URL=https://appleid.apple.com/auth/token
APPLE_REVOKE_URL=https://appleid.apple.com/auth/revoke
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
USE_DUMMY_PARSER=true
# Faz 4 senkronizasyon kabul testleri tamamlanmadan true yapmayın.
ASSISTANT_ENABLED=false
ASSISTANT_MODEL=gemini-3.5-flash-lite
# Use a different Google project/key than receipt parsing. Store the real value
# only in backend/.env or the deployment platform's encrypted secrets.
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_CONSENT_VERSION=2026-08-01
ASSISTANT_REQUEST_TIMEOUT_MS=25000
ASSISTANT_PROVIDER_TIMEOUT_MS=10000
ASSISTANT_USER_BURST_LIMIT=6
ASSISTANT_USER_DAILY_LIMIT=100
ASSISTANT_MAX_PERIOD_DAYS=3660
